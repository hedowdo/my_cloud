{
    auto_https off
    admin off
}
:8080 {
    header {
        X-Content-Type-Options nosniff
        Referrer-Policy no-referrer
        Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src 'self'; worker-src 'self'; media-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
    }
    handle /api/* {
        reverse_proxy api:8000
    }
    handle {
        root * /srv/frontend
        try_files {path} /index.html
        file_server
    }
}
