# Template only. Generate independent secrets on the host; never copy development.env.
CLOUD_HOST=CHOOSE_NAME.duckdns.org
DATA_ROOT=/srv/my-cloud-data
DATA_VOLUME_UUID=RECORD_VERIFIED_FILESYSTEM_UUID
DATABASE_IMAGE=postgres@sha256:REPLACE_WITH_APPROVED_MULTIARCH_DIGEST
API_IMAGE=REPLACE_WITH_RETAINED_IMAGE@sha256:APPROVED_DIGEST
FRONTEND_IMAGE=REPLACE_WITH_RETAINED_IMAGE@sha256:APPROVED_DIGEST
POSTGRES_PASSWORD=GENERATE_64_HEX_CHARACTERS
MIGRATION_PASSWORD=GENERATE_64_HEX_CHARACTERS
APP_DATABASE_PASSWORD=GENERATE_64_HEX_CHARACTERS
AUTH_RATE_SECRET=GENERATE_64_HEX_CHARACTERS
# 100 GB is a target. Replace only after measuring the mounted volume's usable space.
STORAGE_POOL_BYTES=100000000000
STORAGE_RESERVE_BYTES=10000000000
